# Copy to .env and adjust. Every key is optional unless marked required.

# Shared by api and judge-worker
VALENCE_ENV=dev
DATABASE_URL=postgres://valence:valence@localhost:5432/valence?sslmode=disable
INTERNAL_TOKEN=
LOG_LEVEL=info

# api
API_ADDR=:8080
API_INTERNAL_ADDR=:8090
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
BLOB_DIR=.data/blobs
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=
SESSION_TTL=720h
MAX_CODE_KIB=64
SUBMIT_COOLDOWN=5s
MAX_ACTIVE_SUBMISSIONS=3
# AUTO_MIGRATE=true

# judge-worker
WORKER_ADDR=:8081
API_INTERNAL_URL=http://localhost:8090
WORKER_SLOTS=0
JUDGE_PROVIDER=auto
JUDGE_CACHE_DIR=.data/judge-cache
JUDGE_CACHE_MAX_MIB=2048
JUDGE_WORK_DIR=.data/judge-work
ISOLATE_BIN=isolate
ISOLATE_BOX_BASE=0
